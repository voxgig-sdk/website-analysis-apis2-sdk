# Entity: performance

main: kit: entity: performance: {

  alias: field: {}

  fields: [
    {
      name: "load_time"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "page_size"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "performance_score"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "request"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "performance"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://example.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/performance"
          parts: [
            "performance"
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
